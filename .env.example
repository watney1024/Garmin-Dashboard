# ============================================================================
# Garmin-Dashboard environment template
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# 复制为 `.env` 并填写；`.env` 已被 gitignore，绝不要提交真实值。
# ============================================================================

# --- garmin-mcp source (REQUIRED to run garmin_pull.py / garmin_schedule.py)
# Path to a local clone of Taxuspt/garmin_mcp (for China accounts: on PR #249 branch,
# see docs/01). Can also be a pip/git package spec consumed by `uvx --from`.
# 本地 garmin_mcp clone 路径（CN 账户需 PR #249 分支，见 docs/01）。
GARMIN_MCP_SRC=

# --- uvx binary (optional). Default: `uvx` on PATH.
# uvx 可执行文件（可选），默认使用 PATH 中的 uvx。
# UVX_BIN=

# --- Python version for the uvx env (optional, default 3.12)
# CN 账户的 PR #249 需要 >=3.12。国际账户也建议保持 3.12。
GARMIN_MCP_PYTHON=3.12

# --- Account region. China account: set to true (no proxy needed with PR #249).
# 中国账户设 true；国际账户请删除此行或设为 false。
GARMIN_IS_CN=false

# --- Optional pip index (only needed if you are behind the GFW / use a mirror).
# 可选：中国大陆 pip 镜像，网络通畅时无需设置。
# UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# --- Data directory used by the scripts (default ./data)
GARMIN_DATA_DIR=./data
